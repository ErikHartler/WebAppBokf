@{
    ViewData["Title"] = "Home Page";

    var menus = new[]
    {
        (Controller: "Betalsatts", Name: "Betalningssätt"),
        (Controller: "Bokföringsar", Name: "Bokföringsår"),
        (Controller: "Enhets", Name: "Enheter"),
        (Controller: "Fakturas", Name: "Fakturor"),
        (Controller: "Fakturarads", Name: "Fakturarader"),
        (Controller: "Installningars", Name: "Inställningar"),
        (Controller: "KontaktpersonKunds", Name: "Kontaktpersoner kunder"),
        (Controller: "KontaktpersonLeverantors", Name: "Kontaktpersoner leverantörer"),
        (Controller: "Kontoes", Name: "Konton"),
        (Controller: "Kostnadsbarares", Name: "Kostnadsbärare"),
        (Controller: "Kunds", Name: "Kunder"),
        (Controller: "Landskods", Name: "Landskoder"),
        (Controller: "LevFakturas", Name: "Leverantörsfakturor"),
        (Controller: "LevFakturaRads", Name: "Leverantörsfakturarader"),
        (Controller: "Leverantors", Name: "Leverantörer"),
        (Controller: "MallTransaktioners", Name: "Transaktionsmallar"),
        (Controller: "MallVerifikats", Name: "Verifikatmallar"),
        (Controller: "Menies", Name: "Menyer"),
        (Controller: "Menyvals", Name: "Menyval"),
        (Controller: "MenyvalPersFunkts", Name: "Menyval personalfunktioner"),
        (Controller: "MenyvalPersons", Name: "Menyval personer"),
        (Controller: "Personals", Name: "Personal"),
        (Controller: "Personalfunktions", Name: "Personalfunktioner"),
        (Controller: "Produkts", Name: "Produkter"),
        (Controller: "Projekts", Name: "Projekt"),
        (Controller: "ProjektAktivitets", Name: "Projektaktiviteter"),
        (Controller: "Rapports", Name: "Rapporter"),
        (Controller: "RapportRads", Name: "Rapport-rader"),
        (Controller: "Transaktions", Name: "Transaktioner"),
        (Controller: "Verifikations", Name: "Verifikationer")
    };
}

<div class="text-center">
    <h1 class="display-4">Bokföring</h1>
    <p>Välj en del av systemet:</p>
</div>

<div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-3">
    @foreach (var menu in menus)
    {
        <div class="col mb-3">
            <a class="btn btn-outline-primary w-100" asp-controller="@menu.Controller" asp-action="Index">
                @menu.Name
            </a>
        </div>
    }
</div>

