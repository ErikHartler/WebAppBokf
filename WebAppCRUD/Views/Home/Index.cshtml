@{
    ViewData["Title"] = "Home Page";

    var menues = new[]
    {
        (Controller: "Kontoes", Name: "Konton"),
        (Controller: "Kunds", Name: "Kunder"),
        (Controller: "LevFakturas", Name: "Leverantörsfakturor"),
        (Controller: "Leverantors", Name: "Leverantörer"),
        (Controller: "Personals", Name: "Personal"),
        (Controller: "Produkts", Name: "Produkter"),
        (Controller: "Projekts", Name: "Projekt"),
        (Controller: "Rapports", Name: "Rapporter"),
        (Controller: "Verifikations", Name: "Verifikationer")
    };
}

<div class="text-center">
    <h1 class="display-4">Bokföring</h1>
    <p>Välj en del av systemet:</p>
</div>
<div class="col mb-3">
    <a class="btn btn-outline-primary w-100" asp-controller="Home" asp-action="Settings">
        Settings
    </a>
</div>
<div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-3">
    @foreach (var menu in menues)
    {
        <div class="col mb-3">
            <a class="btn btn-outline-primary w-100" asp-controller="@menu.Controller" asp-action="Index">
                @menu.Name
            </a>
        </div>
    }
</div>

