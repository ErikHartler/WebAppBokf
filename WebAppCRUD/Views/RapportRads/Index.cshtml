@model IEnumerable<WebAppCRUD.Models.RapportRad>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Radnr)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.KontoFrom)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.KontoTom)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.RadFromTom)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Radbenamning)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.OmAdderaIb)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.RapportNavigation)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Radnr)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.KontoFrom)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.KontoTom)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.RadFromTom)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Radbenamning)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.OmAdderaIb)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.RapportNavigation.Rapport1)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
