@model IEnumerable<WebAppCRUD.Models.Produkt>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Beskrivning)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Enhetspris)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EnhetNavigation)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Beskrivning)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Enhetspris)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.EnhetNavigation.Enhet1)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.ProduktTjanst">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.ProduktTjanst">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.ProduktTjanst">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
