@model IEnumerable<WebAppCRUD.Models.KontaktpersonLeverantor>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Radnummer)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Fornamn)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Efternamn)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TelefonDirekt)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TelefonHem)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TelefonMobil)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.LeverantorsnummerNavigation)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Radnummer)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Fornamn)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Efternamn)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TelefonDirekt)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TelefonHem)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TelefonMobil)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.LeverantorsnummerNavigation.Leverantorsnummer)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
