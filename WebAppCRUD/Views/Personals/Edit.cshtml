@model  EfLibrary.EFModels.Personal

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Edit</h1>

<h4>Personal</h4>
<hr />
<div class="row">
    <div class="col-md-12">
        <form asp-action="Edit" class="edit-form-grid">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="row">
            <input type="hidden" asp-for="Signatur" />
            <div class="form-group">
                <label asp-for="Fornamn" class="control-label"></label>
                <input asp-for="Fornamn" class="form-control" />
                <span asp-validation-for="Fornamn" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Efternamn" class="control-label"></label>
                <input asp-for="Efternamn" class="form-control" />
                <span asp-validation-for="Efternamn" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Telefonnummer" class="control-label"></label>
                <input asp-for="Telefonnummer" class="form-control" />
                <span asp-validation-for="Telefonnummer" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Mobiltelefon" class="control-label"></label>
                <input asp-for="Mobiltelefon" class="form-control" />
                <span asp-validation-for="Mobiltelefon" class="text-danger"></span>
            </div>
            </div>
            <div class="row">
            <div class="form-group">
                <label asp-for="Personalfunktion" class="control-label"></label>
                <input asp-for="Personalfunktion" class="form-control" />
                <span asp-validation-for="Personalfunktion" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="IntroViaknappar" /> @Html.DisplayNameFor(model => model.IntroViaknappar)
                </label>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
