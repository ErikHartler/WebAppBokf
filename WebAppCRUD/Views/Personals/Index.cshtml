@model IEnumerable<WebAppCRUD.Models.Personal>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Fornamn)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Efternamn)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Telefonnummer)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Mobiltelefon)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Personalfunktion)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IntroViaknappar)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Fornamn)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Efternamn)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Telefonnummer)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Mobiltelefon)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Personalfunktion)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IntroViaknappar)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Signatur">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Signatur">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Signatur">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
