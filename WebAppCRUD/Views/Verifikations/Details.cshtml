@model  EfLibrary.EFModels.Verifikation

@{
    ViewData["Title"] = "Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Details</h1>

<div>
    <h4>Verifikation</h4>
    <hr />
    <dl class="details-list">
        <div class="row details-row"><div class="details-field"><dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Verifikation1)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Verifikation1)
        </dd></div>

        <div class="details-field"><dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Beskrivning)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Beskrivning)
        </dd></div>
        <div class="details-field"><dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Transaktionsdatum)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Transaktionsdatum)
        </dd></div>
        <div class="details-field"><dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.DebetKr)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.DebetKr)
        </dd></div></div>
        <div class="row details-row"><div class="details-field"><dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.KreditKr)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.KreditKr)
        </dd></div>
        <div class="details-field"><dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Bokforingsdatum)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Bokforingsdatum)
        </dd></div>
        <div class="details-field"><dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.FakturanrNavigation)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.FakturanrNavigation.Fakturanummer)
        </dd></div>
        <div class="details-field"><dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.KundnummerNavigation)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.KundnummerNavigation.Kundnummer)
        </dd></div></div>

        <div class="row details-row"><div class="details-field"><dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Transaktions.FirstOrDefault().Verifikation)
        </dt></div>
        <div class="details-field"><dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Transaktions.FirstOrDefault().Konto)
        </dt></div>
        <div class="details-field"><dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Transaktions.FirstOrDefault().DebetKr)
        </dt></div>
        <div class="details-field"><dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Transaktions.FirstOrDefault().KreditKr)
        </dt></div></div>
    </dl>

    @foreach (Transaktion trans in Model.Transaktions)
    {
        
<dl class="details-list">
    <div class="row details-row"><div class="details-field"><dd class="col-sm-2">
        @trans.Verifikation
    </dd></div>
    <div class="details-field"><dd class="col-sm-2">
        @trans.Konto
    </dd></div>
    <div class="details-field"><dd class="col-sm-2">
        @Math.Round(trans.DebetKr.Value,2)
    </dd></div>
    <div class="details-field"><dd class="col-sm-2">
        @Math.Round(trans.KreditKr.Value, 2)
    </dd></div></div>
</dl>
    }
<dl class="details-list">
    <div class="row details-row"><div class="details-field"><dd class="col-sm-2">
        &nbsp;
    </dd></div>
    <div class="details-field"><dd class="col-sm-2">
        &nbsp;
    </dd></div>
    <div class="details-field"><dd class="col-sm-2">
        @Math.Round(Model.Transaktions.Sum(t => t.DebetKr.Value), 2)
    </dd></div>
    <div class="details-field"><dd class="col-sm-2">
        @Math.Round(Model.Transaktions.Sum(t => t.KreditKr.Value), 2)
    </dd></div></div>
</dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model.Verifikation1">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
