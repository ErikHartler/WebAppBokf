@model IEnumerable<WebAppCRUD.Models.ProjektAktivitet>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Aktivitetsnummer)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.StartFrom)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TillOchMed)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.LeverantorsnummerNavigation)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ProjektnummerNavigation)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Aktivitetsnummer)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.StartFrom)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TillOchMed)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.LeverantorsnummerNavigation.Leverantorsnummer)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ProjektnummerNavigation.Projektnr)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
