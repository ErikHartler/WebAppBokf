@model IEnumerable<EfLibrary.EFModels.Konto>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Arsredovisningsrad)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Benamning)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IbDebetKr)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IbKreditKr)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.OmDebet)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Skattekonto)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Arsredovisningsrad)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Benamning)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IbDebetKr)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IbKreditKr)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.OmDebet)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Skattekonto)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Konto1">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Konto1">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Konto1">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
